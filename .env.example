# MAKEPDF Environment Configuration
# Copy this file to .env and replace with your local settings

FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/makepdf
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_CONTENT_LENGTH=52428800
PORT=5000
