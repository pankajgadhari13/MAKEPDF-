{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and usage metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "filesProcessed": { "type": "number" },
        "pdfsCreated": { "type": "number" },
        "storageUsedMb": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email", "name", "role", "createdAt"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "PDF tool processing history log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "filename": { "type": "string" },
        "tool": { "type": "string" },
        "date": { "type": "string" },
        "size": { "type": "string" },
        "status": { "type": "string", "enum": ["Completed", "Processing", "Failed"] },
        "downloadUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "filename", "tool", "date", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores individual user profile data and statistics"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/HistoryItem" },
      "description": "Stores user history records for processed PDF documents"
    }
  }
}
